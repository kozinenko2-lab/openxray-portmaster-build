+            // SDL trigger mappings vary between 0..32767 and signed physical
+            // axes.  Treat all negative values as released and use hysteresis.
+            for (int i = SDL_CONTROLLER_AXIS_TRIGGERLEFT; i <= SDL_CONTROLLER_AXIS_TRIGGERRIGHT; ++i) {
