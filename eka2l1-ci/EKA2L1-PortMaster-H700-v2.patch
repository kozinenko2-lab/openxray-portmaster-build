diff -ruN '--exclude=__pycache__' a/src/emu/drivers/src/graphics/backend/context_sdl2.cpp b/src/emu/drivers/src/graphics/backend/context_sdl2.cpp
--- a/src/emu/drivers/src/graphics/backend/context_sdl2.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/emu/drivers/src/graphics/backend/context_sdl2.cpp	2026-10-08 03:12:17.895754753 +0000
@@ -0,0 +1,111 @@
+// Copyright (c) 2026 EKA2L1 PortMaster contributors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "context_sdl2.h"
+#include <common/log.h>
+
+namespace eka2l1::drivers::graphics {
+    static void set_gles_attributes(bool share) {
+        // Important for H700: request ES before SDL creates/loads the GL path.
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+        SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+        SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 0);
+        SDL_GL_SetAttribute(SDL_GL_STENCIL_SIZE, 0);
+        SDL_GL_SetAttribute(SDL_GL_SHARE_WITH_CURRENT_CONTEXT, share ? 1 : 0);
+    }
+
+    gl_context_sdl2::gl_context_sdl2(const window_system_info &wsi, bool, bool)
+        : window_(static_cast<SDL_Window *>(wsi.render_window)) {
+        m_opengl_mode = mode::opengl_es;
+        if (!create(nullptr)) {
+            LOG_CRITICAL(DRIVER_GRAPHICS, "PortMaster SDL GLES context creation failed: {}", SDL_GetError());
+        }
+    }
+
+    gl_context_sdl2::gl_context_sdl2(SDL_Window *window, SDL_GLContext share_with)
+        : window_(window) {
+        m_opengl_mode = mode::opengl_es;
+        m_is_shared = true;
+        if (!create(share_with)) {
+            LOG_CRITICAL(DRIVER_GRAPHICS, "PortMaster shared SDL GLES context creation failed: {}", SDL_GetError());
+        }
+    }
+
+    bool gl_context_sdl2::create(SDL_GLContext share_with) {
+        if (!window_) {
+            return false;
+        }
+
+        if (share_with) {
+            if (SDL_GL_MakeCurrent(window_, share_with) != 0) {
+                return false;
+            }
+        }
+
+        set_gles_attributes(share_with != nullptr);
+        context_ = SDL_GL_CreateContext(window_);
+        if (!context_) {
+            return false;
+        }
+
+        if (SDL_GL_MakeCurrent(window_, context_) != 0) {
+            SDL_GL_DeleteContext(context_);
+            context_ = nullptr;
+            return false;
+        }
+
+        int width = 0;
+        int height = 0;
+        SDL_GL_GetDrawableSize(window_, &width, &height);
+        m_backbuffer_width = static_cast<std::uint32_t>(width > 0 ? width : 1);
+        m_backbuffer_height = static_cast<std::uint32_t>(height > 0 ? height : 1);
+        return true;
+    }
+
+    gl_context_sdl2::~gl_context_sdl2() {
+        if (context_) {
+            if (SDL_GL_GetCurrentContext() == context_) {
+                clear_current();
+            }
+            SDL_GL_DeleteContext(context_);
+        }
+    }
+
+    bool gl_context_sdl2::make_current() {
+        return window_ && context_ && SDL_GL_MakeCurrent(window_, context_) == 0;
+    }
+
+    bool gl_context_sdl2::clear_current() {
+        return !window_ || SDL_GL_MakeCurrent(window_, nullptr) == 0;
+    }
+
+    void gl_context_sdl2::swap_buffers() {
+        if (window_ && context_) {
+            SDL_GL_SwapWindow(window_);
+        }
+    }
+
+    void gl_context_sdl2::update(const std::uint32_t new_width, const std::uint32_t new_height) {
+        m_backbuffer_width = new_width;
+        m_backbuffer_height = new_height;
+    }
+
+    void gl_context_sdl2::set_swap_interval(const std::int32_t interval) {
+        if (SDL_GL_SetSwapInterval(interval) != 0) {
+            LOG_WARN(DRIVER_GRAPHICS, "SDL_GL_SetSwapInterval({}) failed: {}", interval, SDL_GetError());
+        }
+    }
+
+    bool gl_context_sdl2::is_headless() const {
+        return window_ == nullptr;
+    }
+
+    std::unique_ptr<gl_context> gl_context_sdl2::create_shared_context() {
+        if (!window_ || !context_) {
+            return nullptr;
+        }
+        return std::unique_ptr<gl_context>(new gl_context_sdl2(window_, context_));
+    }
+}
