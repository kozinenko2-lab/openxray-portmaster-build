+            const float right_x = normalize_gamepad_axis(
+                SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_RIGHTX), ANALOG_DEADZONE);
+            const float right_y = normalize_gamepad_axis(
+                SDL_GameControllerGetAxis(controller, SDL_CONTROLLER_AXIS_RIGHTY), ANALOG_DEADZONE);
+
+            if (on_joy_move) {
+                on_joy_move(jid, CONTROLLER_BUTTON_CODE_LEFT_STICK, left_x, left_y);
+                on_joy_move(jid, CONTROLLER_BUTTON_CODE_RIGHT_STICK, right_x, right_y);
+            }
+
+            // DualStick-derived behaviour: expose each analogue direction as a
+            // stable virtual button, but add hysteresis so a stick hovering near
+            // the threshold cannot spam key up/down events.  SDL_GameController
+            // already canonicalises RX/RY vs Z/RZ layouts through its mapping DB.
+            const float stick_axes[4] = {left_x, left_y, right_x, right_y};
+            for (int i = 0; i < 4; ++i) {
+                const float axis = stick_axes[i];
+                const bool old_positive = current_pad.axis_positive[i];
+                const bool old_negative = current_pad.axis_negative[i];
+                const bool new_positive = old_positive
+                    ? axis >= ANALOG_RELEASE_THRESHOLD
+                    : axis >= ANALOG_ACKNOWLEDGE_THRESHOLD;
+                const bool new_negative = old_negative
+                    ? axis <= -ANALOG_RELEASE_THRESHOLD
+                    : axis <= -ANALOG_ACKNOWLEDGE_THRESHOLD;
+
+                if (old_positive != new_positive && on_button_event) {
+                    on_button_event(jid, CONTROLLER_BUTTON_CODE_JOYSTICK_BASE + i * 2, new_positive);
                 }
-            } else if (gamepads.count(jid) > 0) {
-                // Disconnect
-                if (gamepads[jid].controller) {
-                    SDL_GameControllerClose(gamepads[jid].controller);
+                if (old_negative != new_negative && on_button_event) {
+                    on_button_event(jid, CONTROLLER_BUTTON_CODE_JOYSTICK_BASE + i * 2 + 1, new_negative);
                 }
-    
-                gamepads.erase(jid);
+                current_pad.axis_positive[i] = new_positive;
+                current_pad.axis_negative[i] = new_negative;
+                current_pad.axis[i] = axis;
+            }
+
+            // SDL trigger mappings vary between 0..32767 and signed physical
+            // axes.  Treat all negative values as released and use hysteresis.
+            for (int i = SDL_CONTROLLER_AXIS_TRIGGERLEFT; i <= SDL_CONTROLLER_AXIS_TRIGGERRIGHT; ++i) {
+                const auto sdl_axis = static_cast<SDL_GameControllerAxis>(i);
+                const Sint16 raw = SDL_GameControllerGetAxis(controller, sdl_axis);
+                const float axis = std::max(0.0f, raw / 32767.0f);
+                const bool was_pressed = current_pad.axis_positive[i];
+                const bool is_pressed = was_pressed
+                    ? axis >= TRIGGER_RELEASE_THRESHOLD
+                    : axis >= ANALOG_ACKNOWLEDGE_THRESHOLD;
+                if (was_pressed != is_pressed && on_button_event) {
+                    on_button_event(jid,
+                        CONTROLLER_BUTTON_CODE_LEFT_TRIGGER + (i - SDL_CONTROLLER_AXIS_TRIGGERLEFT),
+                        is_pressed);
+                }
+                current_pad.axis_positive[i] = is_pressed;
+                current_pad.axis[i] = axis;
+            }
+        }
+
+        for (auto it = gamepads.begin(); it != gamepads.end();) {
+            if (seen.count(it->first) != 0) {
+                ++it;
+                continue;
             }
+            LOG_INFO(COMMON, "SDL controller disconnected: id={}", static_cast<int>(it->first));
+            if (it->second.controller) {
+                SDL_GameControllerClose(it->second.controller);
+            }
+            it = gamepads.erase(it);
         }
     }
 
     void emu_controller_sdl2::run() {
-        static constexpr const char *MAPPING_PATH = "resources//gamecontrollerdb.txt";
-        SDL_GameControllerAddMappingsFromFile(MAPPING_PATH);
+        // Load the large upstream DB first, then the measured H700 mapping so
+        // our built-in ANBERNIC-keys entry wins if the generic DB ever grows an
+        // older/conflicting entry for the same GUID.
+        const int generic_mappings = SDL_GameControllerAddMappingsFromFile("resources/gamecontrollerdb.txt");
+        if (generic_mappings >= 0) {
