+    static bool load_system_ca(mbedtls_x509_crt &ca) {
+        const char *override_path = std::getenv("SSL_CERT_FILE");
+        if (override_path && *override_path && mbedtls_x509_crt_parse_file(&ca, override_path) == 0) {
+            return true;
+        }
+
+        static const char *paths[] = {
+            "/etc/ssl/certs/ca-certificates.crt",
+            "/etc/pki/tls/certs/ca-bundle.crt",
+            "/etc/ssl/ca-bundle.pem",
+            "/etc/ssl/cert.pem"
+        };
+
+        for (const char *path : paths) {
+            if (mbedtls_x509_crt_parse_file(&ca, path) == 0) {
+                return true;
+            }
+        }
+        return false;
+    }
