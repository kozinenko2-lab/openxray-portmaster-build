+#!/bin/sh
+# EKA2L1 PortMaster / H700 launcher
+GAMEDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
+cd "$GAMEDIR" || exit 1
+
+export HOME="$GAMEDIR"
+export XDG_CONFIG_HOME="$GAMEDIR/config"
+export XDG_CACHE_HOME="$GAMEDIR/cache"
+mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
+
+# Some H700 firmware SDL builds require the vendor fbdev video backend.  Leave
+# autodetection alone by default, but allow the port package/CFW to force it:
+#   EKA2L1_SDL_VIDEODRIVER=mali ./EKA2L1.sh 0x12345678
+if [ -n "${EKA2L1_SDL_VIDEODRIVER:-}" ]; then
+    export SDL_VIDEODRIVER="$EKA2L1_SDL_VIDEODRIVER"
+fi
+
+UID_ARG="${1:-${EKA2L1_APP_UID:-}}"
+if [ -z "$UID_ARG" ]; then
+    echo "No Symbian app UID supplied. Installed apps:" >> "$GAMEDIR/EKA2L1.log"
+    exec "$GAMEDIR/eka2l1_portmaster" --list-apps >> "$GAMEDIR/EKA2L1.log" 2>&1
+fi
+
+exec "$GAMEDIR/eka2l1_portmaster" --uid "$UID_ARG" >> "$GAMEDIR/EKA2L1.log" 2>&1
