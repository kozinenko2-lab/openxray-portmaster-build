diff -ruN '--exclude=__pycache__' a/src/emu/drivers/src/network/tls_trust_posix.cpp b/src/emu/drivers/src/network/tls_trust_posix.cpp
--- a/src/emu/drivers/src/network/tls_trust_posix.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/emu/drivers/src/network/tls_trust_posix.cpp	2026-10-08 03:12:17.896485080 +0000
@@ -0,0 +1,59 @@
+// Copyright (c) 2026 EKA2L1 PortMaster contributors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "tls_trust.h"
+
+#include <mbedtls/x509_crt.h>
+#include <cstdlib>
+
+namespace eka2l1::drivers {
+    static bool load_system_ca(mbedtls_x509_crt &ca) {
+        const char *override_path = std::getenv("SSL_CERT_FILE");
+        if (override_path && *override_path && mbedtls_x509_crt_parse_file(&ca, override_path) == 0) {
+            return true;
+        }
+
+        static const char *paths[] = {
+            "/etc/ssl/certs/ca-certificates.crt",
+            "/etc/pki/tls/certs/ca-bundle.crt",
+            "/etc/ssl/ca-bundle.pem",
+            "/etc/ssl/cert.pem"
+        };
+
+        for (const char *path : paths) {
+            if (mbedtls_x509_crt_parse_file(&ca, path) == 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool verify_system_certificate(const tls_certificate_chain &chain, const std::string &hostname) {
+        if (chain.empty() || hostname.empty()) {
+            return false;
+        }
+
+        mbedtls_x509_crt peer;
+        mbedtls_x509_crt ca;
+        mbedtls_x509_crt_init(&peer);
+        mbedtls_x509_crt_init(&ca);
+
+        bool parsed = true;
+        for (const auto &der : chain) {
+            if (der.empty() || mbedtls_x509_crt_parse_der(&peer, der.data(), der.size()) != 0) {
+                parsed = false;
+                break;
+            }
+        }
+
+        bool verified = false;
+        if (parsed && load_system_ca(ca)) {
+            std::uint32_t flags = 0;
+            verified = mbedtls_x509_crt_verify(&peer, &ca, nullptr, hostname.c_str(), &flags, nullptr, nullptr) == 0
+                && flags == 0;
+        }
+
+        mbedtls_x509_crt_free(&ca);
+        mbedtls_x509_crt_free(&peer);
+        return verified;
+    }
+}
diff -ruN '--exclude=__pycache__' a/src/emu/portmaster/CMakeLists.txt b/src/emu/portmaster/CMakeLists.txt
