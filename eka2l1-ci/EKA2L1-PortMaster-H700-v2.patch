@@ -0,0 +1,87 @@
+cmake_minimum_required(VERSION 3.8)
+
+add_executable(eka2l1_portmaster
+    include/portmaster/emu_window_sdl2.h
+    include/portmaster/state.h
+    src/emu_window_sdl2.cpp
+    src/main.cpp
+    src/screen_presenter.cpp
+    src/state.cpp)
+
+target_include_directories(eka2l1_portmaster PRIVATE include)
+
+target_link_libraries(eka2l1_portmaster PRIVATE
+    common
+    cpu
+    drivers
+    SDL2
+    glad
+    lunasvg
+    epoc
+    epockern
+    epocpkg
+    epocservs
+    sqlite3
+    yaml-cpp)
+
+add_dependencies(eka2l1_portmaster
+    audiooutputrouting
+    avkonfep
+    ecam
+    scdv
+    mediaclientaudio
+    mediaclientaudiostream
+    mediaclientvideo
+    vibractrl
+    backlightctrl
+    postingsurfacefactory
+    goommonitor
+    ssl
+    commdb)
+
+set_property(TARGET eka2l1_portmaster APPEND PROPERTY LINK_DEPENDS
+    "${PROJECT_SOURCE_DIR}/src/patch/ssl/group/ssl_general.dll"
+    "${PROJECT_SOURCE_DIR}/src/patch/ssl/group/ssl.dll.map"
+    "${PROJECT_SOURCE_DIR}/src/patch/commdb/group/commdb_v6.dll"
+    "${PROJECT_SOURCE_DIR}/src/patch/commdb/group/commdb.dll.map")
+
+set_target_properties(eka2l1_portmaster PROPERTIES
+    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
+
+# The OpenGL ES backend intentionally looks up shaders at resources/*.vert|frag,
+# just like Android.  Keep a self-contained PortMaster runtime beside the binary.
+add_custom_command(TARGET eka2l1_portmaster POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/upscale"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:eka2l1_portmaster>/compat"
+    COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:eka2l1_portmaster>/patch"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${PROJECT_SOURCE_DIR}/src/emu/drivers/resources/gles"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${PROJECT_SOURCE_DIR}/src/emu/drivers/resources/upscale"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/upscale"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${PROJECT_SOURCE_DIR}/miscs/compat"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/compat"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory
+            "${CMAKE_BINARY_DIR}/bin/patch"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/patch"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${PROJECT_SOURCE_DIR}/src/emu/drivers/resources/defaultbank.hsb"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/defaultbank.hsb"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${PROJECT_SOURCE_DIR}/src/emu/drivers/resources/defaultbank.sf2"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/defaultbank.sf2"
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+            "${PROJECT_SOURCE_DIR}/src/emu/portmaster/resources/gamecontrollerdb-h700.txt"
+            "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/gamecontrollerdb-h700.txt")
+
+# The upstream SDL controller database is a git submodule and may be absent in a
+# source ZIP.  Copy it only when it has been initialized.
+if (EXISTS "${PROJECT_SOURCE_DIR}/src/external/SDL_GameControllerDB/gamecontrollerdb.txt")
+    add_custom_command(TARGET eka2l1_portmaster POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                "${PROJECT_SOURCE_DIR}/src/external/SDL_GameControllerDB/gamecontrollerdb.txt"
+                "$<TARGET_FILE_DIR:eka2l1_portmaster>/resources/gamecontrollerdb.txt")
+endif()
