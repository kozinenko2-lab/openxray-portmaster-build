--- a/src/emu/portmaster/src/install.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/emu/portmaster/src/install.cpp	2026-10-09 15:35:34.111130884 +0000
@@ -0,0 +1,147 @@
+// Copyright (c) 2026 EKA2L1 PortMaster contributors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <portmaster/install.h>
+#include <portmaster/state.h>
+
+#include <common/cvt.h>
+#include <common/log.h>
+#include <common/path.h>
+#include <system/devices.h>
+#include <system/installation/archive.h>
+#include <system/installation/firmware.h>
+#include <system/installation/rpkg.h>
+#include <package/manager.h>
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace eka2l1::portmaster {
+namespace {
+namespace fs = std::filesystem;
+
+std::string lower(std::string value) {
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char c) {
+        return static_cast<char>(std::tolower(c));
+    });
+    return value;
+}
+void status(const std::string &text) {
+    std::cout << "[INSTALL] " << text << '\n';
+    // Kept across menu launches so the user can see installation result on screen.
+    std::ofstream out("install_status.txt", std::ios::trunc);
+    if (out) out << text << '\n';
+}
+fs::path adjacent_rpkg(const fs::path &rom) {
+    std::vector<fs::path> packages;
+    std::error_code ec;
+    for (fs::directory_iterator it(rom.parent_path(), fs::directory_options::skip_permission_denied, ec), end;
+         !ec && it != end; it.increment(ec)) {
+        if (it->is_regular_file(ec) && !ec && lower(it->path().extension().string()) == ".rpkg") {
+            if (lower(it->path().stem().string()) == lower(rom.stem().string())) return it->path();
+            packages.push_back(it->path());
+        }
+    }
+    return packages.size() == 1 ? packages.front() : fs::path{};
+}
+bool regular_file(const fs::path &p) {
+    std::error_code ec;
+    const bool ok = fs::is_regular_file(p, ec);
+    if (!ok || ec) status("Input file missing or unreadable: " + p.string());
+    return ok && !ec;
+}
+}
+
+bool install_device_from_file(const std::filesystem::path &file) {
+    if (!regular_file(file)) return false;
+    // Do not create a full Symbian system: the initial installation is allowed
+    // when no device exists and must be completed before state::stage_one().
+    log::setup_log(nullptr);
+    config::state conf;
+    conf.deserialize();
+    std::error_code ec;
+    fs::create_directories(fs::path(conf.storage) / "roms", ec);
+    fs::create_directories(fs::path(conf.storage) / "drives" / "z", ec);
+    if (ec) { status("Unable to create EKA2L1 data directories: " + ec.message()); return false; }
+    device_manager manager(&conf);
+    const std::string roms = add_path(conf.storage, "roms/");
+    const std::string z = add_path(conf.storage, "drives/z/");
+    const std::string ext = lower(file.extension().string());
+    const std::string source = file.string();
+    const bool isolated = true;
+    device_installation_error error = device_installation_general_failure;
+    if (ext == ".rom") {
+        const fs::path rpkg = adjacent_rpkg(file);
+        std::cout << "[INSTALL] ROM=" << source << " RPKG=" << (rpkg.empty() ? "<none>" : rpkg.string()) << '\n';
+        error = loader::install_rom_with_optional_rpkg(&manager, source, rpkg.string(), roms, z,
+                                                       isolated, nullptr, nullptr);
+    } else if (ext == ".rpkg") {
+        // RPKG alone does not include the executable ROM image. Find the ROM
+        // alongside it instead of corrupting an incomplete device record.
+        fs::path candidate = file.parent_path() / (file.stem().string() + ".rom");
+        if (!fs::is_regular_file(candidate)) {
+            std::vector<fs::path> roms_found;
+            for (fs::directory_iterator it(file.parent_path(), ec), end; !ec && it != end; it.increment(ec)) {
+                if (it->is_regular_file(ec) && lower(it->path().extension().string()) == ".rom") roms_found.push_back(it->path());
+            }
+            if (roms_found.size() != 1) {
+                status("RPKG requires a matching .rom in the same directory");
+                return false;
+            }
+            candidate = roms_found[0];
+        }
+        error = loader::install_rom_with_optional_rpkg(&manager, candidate.string(), source, roms, z,
+                                                       isolated, nullptr, nullptr);
+    } else if (ext == ".vpl") {
+        error = install_firmware(&manager, source, conf.storage, roms, isolated,
+            [](const std::vector<std::string> &variants) -> int {
+                if (variants.empty()) return -1;
+                // Minimal frontend: use first variant deterministically.
+                // Future UI can present a variant picker for multi-variant VPL.
+                std::cout << "[INSTALL] VPL variants=" << variants.size() << "; selecting first: " << variants[0] << '\n';
+                return 0;
+            }, nullptr, nullptr);
+    } else if (ext == ".7z" || ext == ".zip") {
+        error = loader::install_archive(&manager, source, roms, z, isolated, nullptr, nullptr);
+    } else {
+        status("Unsupported firmware file: " + file.filename().string());
+        return false;
+    }
+    if (error != device_installation_none) {
+        status("Firmware installation failed, error=" + std::to_string(static_cast<int>(error)));
+        return false;
+    }
+    manager.save_devices();
+    const device *latest = manager.lastest();
+    status(latest ? "Firmware installed: " + latest->model + " (" + latest->firmware_code + ")"
+                  : "Firmware installed successfully");
+    return true;
+}
+
+bool install_sis_from_file(const std::filesystem::path &file) {
+    if (!regular_file(file)) return false;
+    const std::string ext = lower(file.extension().string());
+    if (ext != ".sis" && ext != ".sisx") {
+        status("Unsupported game file. Choose SIS or SISX.");
+        return false;
+    }
+    emulator_state state;
+    if (!state.stage_one() || !state.stage_two()) {
+        status("Install a compatible Symbian firmware before installing SIS/SISX");
+        return false;
+    }
+    // Existing core installer registers apps and copies their files to EKA2L1
+    // virtual drive E. Qt uses the same default drive on this upstream revision.
+    const int result = state.symsys->install_package(common::utf8_to_ucs2(file.string()), drive_e);
+    if (result != static_cast<int>(package::installation_result_success)) {
+        status("SIS/SISX installation failed, error=" + std::to_string(result));
+        return false;
+    }
+    status("Game installed: " + file.filename().string());
+    return true;
+}
+}
