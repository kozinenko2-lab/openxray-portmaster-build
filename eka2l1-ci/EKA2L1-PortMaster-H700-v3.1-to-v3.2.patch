@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <filesystem>
+namespace eka2l1::portmaster {
+    enum class menu_action { quit, install_firmware, install_game, list_apps, probe };
+    struct menu_selection {
+        menu_action action = menu_action::quit;
+        std::filesystem::path path;
+    };
+    // Self-contained SDL2 browser. Operates without installed Symbian firmware.
+    // On input/video failure returns quit and logs the SDL error to stderr.
+    menu_selection open_portmaster_menu(const std::filesystem::path &game_root);
+}
