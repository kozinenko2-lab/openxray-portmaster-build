diff -ruN '--exclude=__pycache__' a/src/emu/portmaster/src/file_browser.cpp b/src/emu/portmaster/src/file_browser.cpp
--- a/src/emu/portmaster/src/file_browser.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/emu/portmaster/src/file_browser.cpp	2026-10-09 15:40:17.822142268 +0000
@@ -0,0 +1,343 @@
+// Copyright (c) 2026 EKA2L1 PortMaster contributors.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <portmaster/file_browser.h>
+#include <SDL.h>
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+
+namespace eka2l1::portmaster {
+namespace {
+namespace fs = std::filesystem;
+#include "font10x14_data.inc"
+
+struct entry { fs::path path; bool directory = false; };
+
+std::string lower(std::string s) {
+    std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return s;
+}
+
+bool supported(const fs::path &path, bool firmware) {
+    const std::string ext = lower(path.extension().string());
+    return firmware ? (ext == ".rom" || ext == ".rpkg" || ext == ".vpl" || ext == ".7z" || ext == ".zip")
+                    : (ext == ".sis" || ext == ".sisx");
+}
+
+// Do not browse into symlinks escaping the managed firmware/games directory.
+bool within(const fs::path &candidate, const fs::path &base) {
+    std::error_code ec;
+    const fs::path absolute_candidate = fs::weakly_canonical(candidate, ec);
+    if (ec) return false;
+    const fs::path absolute_base = fs::weakly_canonical(base, ec);
+    if (ec) return false;
+    auto a = absolute_candidate.begin(), b = absolute_base.begin();
+    for (; b != absolute_base.end(); ++a, ++b) {
+        if (a == absolute_candidate.end() || *a != *b) return false;
+    }
+    return true;
+}
+
+std::vector<entry> scan(const fs::path &folder, const fs::path &root, bool firmware) {
+    std::vector<entry> result;
+    std::error_code ec;
+    for (fs::directory_iterator it(folder, fs::directory_options::skip_permission_denied, ec), end; !ec && it != end; it.increment(ec)) {
+        const auto &item = *it;
+        if (!within(item.path(), root)) continue;
+        std::error_code status_ec;
+        const bool dir = item.is_directory(status_ec);
+        if (status_ec) continue;
+        if (dir || (item.is_regular_file(status_ec) && !status_ec && supported(item.path(), firmware))) {
+            result.push_back({item.path(), dir});
+            // Keep file browsing bounded on handhelds with only 1 GB RAM.
+            if (result.size() >= 4096) {
+                std::cerr << "[BROWSER] Directory listing truncated to 4096 entries\n";
+                break;
+            }
+        }
+    }
+    if (ec) std::cerr << "[BROWSER] Failed to scan " << folder << ": " << ec.message() << '\n';
+    std::sort(result.begin(), result.end(), [](const entry &a, const entry &b) {
+        if (a.directory != b.directory) return a.directory;
+        return lower(a.path.filename().string()) < lower(b.path.filename().string());
+    });
+    return result;
+}
+
+int glyph_index(char32_t unicode) {
+    if (unicode >= 32 && unicode <= 126) return int(unicode) - 32;
+    if (unicode >= 0x410 && unicode <= 0x44F) return 95 + int(unicode) - 0x410;
+    if (unicode == 0x401) return 159;
+    if (unicode == 0x451) return 160;
+    return '?' - 32;
+}
+
+std::uint32_t next_codepoint(const std::string &s, std::size_t &position) {
+    const unsigned char c = static_cast<unsigned char>(s[position++]);
+    if (c < 0x80) return c;
+    int continuation_count = 0;
+    std::uint32_t code = 0;
+    if ((c & 0xe0) == 0xc0) { continuation_count = 1; code = c & 0x1f; }
+    else if ((c & 0xf0) == 0xe0) { continuation_count = 2; code = c & 0x0f; }
+    else if ((c & 0xf8) == 0xf0) { continuation_count = 3; code = c & 0x07; }
+    else return '?';
+    for (int n = 0; n < continuation_count; ++n) {
+        if (position >= s.size()) return '?';
+        const unsigned char d = static_cast<unsigned char>(s[position]);
+        if ((d & 0xc0) != 0x80) return '?';
+        ++position;
+        code = (code << 6) | (d & 0x3f);
+    }
+    return code;
+}
+
+void draw_text(SDL_Renderer *renderer, int x, int y, const std::string &s, SDL_Color color, int max_width = 605) {
+    SDL_SetRenderDrawColor(renderer, color.r, color.g, color.b, 255);
+    int xpos = x;
+    for (std::size_t i = 0; i < s.size();) {
+        const auto point = next_codepoint(s, i);
+        if (point == '\n') { xpos = x; y += 17; continue; }
+        if (xpos + 11 > max_width) break;
+        const auto &glyph = kGlyphs[glyph_index(point)];
+        for (int row = 0; row < 14; ++row) {
+            const auto pixels = glyph[row];
+            for (int col = 0; col < 10; ++col) {
+                if (pixels & (1 << (9 - col))) {
+                    SDL_RenderDrawPoint(renderer, xpos + col, y + row);
+                }
+            }
+        }
+        xpos += 11;
+    }
+}
+
+void rect(SDL_Renderer *renderer, int x, int y, int w, int h, SDL_Color color) {
+    SDL_Rect r{x, y, w, h};
+    SDL_SetRenderDrawColor(renderer, color.r, color.g, color.b, color.a);
+    SDL_RenderFillRect(renderer, &r);
+}
+
+std::string trim_ends(const std::string &s, std::size_t maxbytes) {
+    if (s.size() <= maxbytes) return s;
+    // Byte clipping is visual-only. Never truncate actual filesystem paths.
+    std::size_t start = s.size() - maxbytes;
+    while (start < s.size() && (static_cast<unsigned char>(s[start]) & 0xc0) == 0x80) ++start;
+    return "..." + s.substr(start);
+}
+
+bool action_up(const SDL_Event &e) {
+    return (e.type == SDL_KEYDOWN && (e.key.keysym.sym == SDLK_UP || e.key.keysym.sym == SDLK_w)) ||
+           (e.type == SDL_CONTROLLERBUTTONDOWN && e.cbutton.button == SDL_CONTROLLER_BUTTON_DPAD_UP);
+}
+bool action_down(const SDL_Event &e) {
+    return (e.type == SDL_KEYDOWN && (e.key.keysym.sym == SDLK_DOWN || e.key.keysym.sym == SDLK_s)) ||
+           (e.type == SDL_CONTROLLERBUTTONDOWN && e.cbutton.button == SDL_CONTROLLER_BUTTON_DPAD_DOWN);
+}
+bool action_accept(const SDL_Event &e) {
+    return (e.type == SDL_KEYDOWN && (e.key.keysym.sym == SDLK_RETURN || e.key.keysym.sym == SDLK_SPACE)) ||
+           (e.type == SDL_CONTROLLERBUTTONDOWN && e.cbutton.button == SDL_CONTROLLER_BUTTON_A);
+}
+bool action_back(const SDL_Event &e) {
+    return (e.type == SDL_KEYDOWN && (e.key.keysym.sym == SDLK_ESCAPE || e.key.keysym.sym == SDLK_BACKSPACE)) ||
+           (e.type == SDL_CONTROLLERBUTTONDOWN && (e.cbutton.button == SDL_CONTROLLER_BUTTON_B || e.cbutton.button == SDL_CONTROLLER_BUTTON_GUIDE));
+}
+
+class menu {
+    SDL_Window *window_ = nullptr;
+    SDL_Renderer *renderer_ = nullptr;
+    SDL_GameController *pad_ = nullptr;
+    fs::path root_;
+    fs::path folder_;
+    std::vector<entry> files_;
+    std::size_t index_ = 0;
+    int main_index_ = 0;
+    bool browsing_ = false;
+    bool browse_firmware_ = true;
+    bool analog_up_ = false;
+    bool analog_down_ = false;
+    bool dirty_ = true;
+    std::string last_status_;
+
+    void set_browse(bool firmware) {
+        browse_firmware_ = firmware;
+        root_ = fs::weakly_canonical(fs::path(firmware ? "firmware" : "games"));
+        folder_ = root_;
+        refresh();
+        browsing_ = true;
+    }
+    void refresh() {
+        files_ = scan(folder_, root_, browse_firmware_);
+        index_ = 0;
+        dirty_ = true;
+    }
+    void up() {
+        const int size = browsing_ ? static_cast<int>(files_.size()) : 5;
+        if (size == 0) return;
+        if (browsing_) index_ = (index_ + files_.size() - 1) % files_.size();
+        else main_index_ = (main_index_ + size - 1) % size;
+        dirty_ = true;
+    }
+    void down() {
+        const int size = browsing_ ? static_cast<int>(files_.size()) : 5;
+        if (size == 0) return;
+        if (browsing_) index_ = (index_ + 1) % files_.size();
+        else main_index_ = (main_index_ + 1) % size;
+        dirty_ = true;
+    }
+    void back() {
+        if (!browsing_) return;
+        if (folder_ == root_) { browsing_ = false; dirty_ = true; return; }
+        folder_ = folder_.parent_path();
+        if (!within(folder_, root_)) folder_ = root_;
+        refresh();
+    }
+    menu_selection accept() {
+        if (!browsing_) {
+            switch (main_index_) {
+            case 0: set_browse(true); return {};
+            case 1: set_browse(false); return {};
+            case 2: return {menu_action::list_apps, {}};
+            case 3: return {menu_action::probe, {}};
+            default: return {menu_action::quit, {}};
+            }
+        }
+        if (files_.empty()) return {};
+        const entry &selected = files_[index_];
+        if (selected.directory) {
+            folder_ = selected.path;
+            refresh();
+            return {};
+        }
+        return {browse_firmware_ ? menu_action::install_firmware : menu_action::install_game, selected.path};
+    }
+    void draw() {
+        SDL_SetRenderDrawColor(renderer_, 17, 22, 35, 255);
+        SDL_RenderClear(renderer_);
+        rect(renderer_, 0, 0, 640, 48, {40, 89, 132, 255});
+        draw_text(renderer_, 20, 16, "EKA2L1  /  PORTMASTER H700", {255, 255, 255, 255});
+        const SDL_Color regular{210, 223, 234, 255}, highlight{255, 255, 255, 255};
+        if (!browsing_) {
+            draw_text(renderer_, 22, 66, "DEVICE / PACKAGE MANAGEMENT", regular);
+            const char *options[] = {
+                "Install phone OS / firmware",
+                "Install SIS / SISX game",
+                "List apps -> EKA2L1.log",
+                "Test Mali GLES / controller",
+                "Exit"
+            };
+            for (int i = 0; i < 5; ++i) {
+                const int y = 102 + i * 43;
+                if (i == main_index_) rect(renderer_, 16, y - 5, 608, 31, {54, 111, 163, 255});
+                draw_text(renderer_, 30, y, options[i], i == main_index_ ? highlight : regular);
+            }
+            draw_text(renderer_, 20, 344, "Firmware: /EKA2L1/firmware/", {170, 206, 223, 255});
+            draw_text(renderer_, 20, 363, "Games:    /EKA2L1/games/", {170, 206, 223, 255});
+            if (!last_status_.empty()) {
+                draw_text(renderer_, 20, 401, "LAST: " + trim_ends(last_status_, 45), {232, 194, 121, 255});
+            }
+        } else {
+            draw_text(renderer_, 20, 60, browse_firmware_ ? "FIRMWARE (.ROM .RPKG .VPL .7Z .ZIP)" : "GAMES (.SIS .SISX)", regular);
+            const std::string dir = folder_.lexically_relative(root_).generic_string();
+            draw_text(renderer_, 20, 82, "Folder: " + trim_ends(dir.empty() || dir == "." ? "/" : dir, 47), {170, 206, 223, 255});
+            if (files_.empty()) draw_text(renderer_, 24, 150, "No supported files here. Press B to go back.", regular);
+            const std::size_t first = index_ > 11 ? index_ - 11 : 0;
+            for (std::size_t j = first; j < files_.size() && j < first + 12; ++j) {
+                const int y = 114 + static_cast<int>(j - first) * 25;
+                if (j == index_) rect(renderer_, 13, y - 2, 614, 23, {54, 111, 163, 255});
+                const std::string name = (files_[j].directory ? "[DIR] " : "      ") + files_[j].path.filename().string();
+                draw_text(renderer_, 22, y + 1, trim_ends(name, 50), j == index_ ? highlight : regular);
+            }
+            draw_text(renderer_, 20, 429, std::to_string(files_.size()) + " items", {170, 206, 223, 255});
+        }
+        rect(renderer_, 0, 451, 640, 29, {27, 39, 60, 255});
+        draw_text(renderer_, 19, 458, browsing_ ? "D-PAD / STICK: choose   A: open/install   B: back"
+                                             : "D-PAD / STICK: choose   A: select   B: exit", regular);
+        SDL_RenderPresent(renderer_);
+    }
+
+public:
+    explicit menu(fs::path root) : root_(std::move(root)) {
+        std::ifstream status(root_ / "install_status.txt");
+        if (status) std::getline(status, last_status_);
+    }
+    ~menu() {
+        if (pad_) SDL_GameControllerClose(pad_);
+        if (renderer_) SDL_DestroyRenderer(renderer_);
+        if (window_) SDL_DestroyWindow(window_);
+        SDL_Quit();
+    }
+    menu_selection run() {
+        SDL_SetHint(SDL_HINT_RENDER_SCALE_QUALITY, "0");
+        if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_JOYSTICK) != 0) {
+            std::cerr << "[BROWSER] SDL_Init failed: " << SDL_GetError() << '\n';
+            return {};
+        }
+        // H700-specific mapping has priority over SDL's generic database.
+        SDL_GameControllerAddMappingsFromFile("resources/gamecontrollerdb.txt");
+        SDL_GameControllerAddMappingsFromFile("resources/gamecontrollerdb-h700.txt");
+        for (int i = 0; i < SDL_NumJoysticks(); ++i) {
+            if (SDL_IsGameController(i)) { pad_ = SDL_GameControllerOpen(i); if (pad_) break; }
+        }
+        // Avoid desktop GLX/GL4ES on H700. SDL's GLES2 renderer is sufficient
+        // for the file browser and is separate from the emulation GLES3 driver.
+        SDL_SetHint(SDL_HINT_RENDER_DRIVER, "opengles2");
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+        window_ = SDL_CreateWindow("EKA2L1 PortMaster", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
+                                   640, 480, SDL_WINDOW_SHOWN | SDL_WINDOW_FULLSCREEN_DESKTOP);
+        if (!window_) window_ = SDL_CreateWindow("EKA2L1 PortMaster", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
+                                                 640, 480, SDL_WINDOW_SHOWN);
+        if (!window_) { std::cerr << "[BROWSER] Window error: " << SDL_GetError() << '\n'; return {}; }
+        renderer_ = SDL_CreateRenderer(window_, -1, SDL_RENDERER_PRESENTVSYNC);
+        if (!renderer_) {
+            std::cerr << "[BROWSER] GLES2 renderer unavailable: " << SDL_GetError() << "; trying software\n";
+            SDL_SetHint(SDL_HINT_RENDER_DRIVER, "software");
+            renderer_ = SDL_CreateRenderer(window_, -1, SDL_RENDERER_SOFTWARE);
+        }
+        if (!renderer_) { std::cerr << "[BROWSER] Renderer error: " << SDL_GetError() << '\n'; return {}; }
+        SDL_RenderSetLogicalSize(renderer_, 640, 480);
+        SDL_ShowCursor(SDL_DISABLE);
+        while (true) {
+            if (dirty_) { draw(); dirty_ = false; }
+            SDL_Event e{};
+            if (SDL_WaitEventTimeout(&e, 60) == 0) continue;
+            if (e.type == SDL_QUIT) return {};
+            if (e.type == SDL_CONTROLLERDEVICEADDED && !pad_ && SDL_IsGameController(e.cdevice.which)) {
+                pad_ = SDL_GameControllerOpen(e.cdevice.which);
+            }
+            if (e.type == SDL_CONTROLLERDEVICEREMOVED && pad_ &&
+                SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(pad_)) == e.cdevice.which) {
+                SDL_GameControllerClose(pad_); pad_ = nullptr;
+            }
+            if (e.type == SDL_CONTROLLERAXISMOTION && e.caxis.axis == SDL_CONTROLLER_AXIS_LEFTY) {
+                if (e.caxis.value < -18000 && !analog_up_) { analog_up_ = true; up(); }
+                else if (e.caxis.value > -9000) analog_up_ = false;
+                if (e.caxis.value > 18000 && !analog_down_) { analog_down_ = true; down(); }
+                else if (e.caxis.value < 9000) analog_down_ = false;
+            }
+            if (action_up(e)) up();
+            else if (action_down(e)) down();
+            else if (action_accept(e)) {
+                const auto selected = accept();
+                if (selected.action != menu_action::quit || (selected.action == menu_action::quit && !browsing_ && main_index_ == 4)) return selected;
+            }
+            else if (action_back(e)) {
+                if (!browsing_) return {};
+                back();
+            }
+        }
+    }
+};
+}
+menu_selection open_portmaster_menu(const std::filesystem::path &game_root) {
+    return menu(game_root).run();
+}
+}
