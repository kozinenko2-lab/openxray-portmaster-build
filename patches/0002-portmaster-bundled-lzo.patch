diff --git a/cmake/XRay.Compiler.GNULike.cmake b/cmake/XRay.Compiler.GNULike.cmake
--- a/cmake/XRay.Compiler.GNULike.cmake
+++ b/cmake/XRay.Compiler.GNULike.cmake
@@ -202,7 +202,27 @@ if (NOT WIN32)
             find_package(Theora REQUIRED)
         endif()
 
-        find_package(LZO REQUIRED)
+        # LZO 2.10 is already vendored in oxr_deps by this fork. Use it for
+        # PortMaster/GLES so the handheld build has no distro LZO dependency.
+        if (XRAY_USE_GLES AND EXISTS "${CMAKE_SOURCE_DIR}/oxr_deps/lzo-src/CMakeLists.txt")
+            set(ENABLE_STATIC ON CACHE BOOL "" FORCE)
+            set(ENABLE_SHARED OFF CACHE BOOL "" FORCE)
+            add_subdirectory(
+                "${CMAKE_SOURCE_DIR}/oxr_deps/lzo-src"
+                "${CMAKE_BINARY_DIR}/lzo-portmaster"
+                EXCLUDE_FROM_ALL
+            )
+            if (TARGET lzo_static_lib)
+                target_include_directories(lzo_static_lib
+                    PUBLIC "${CMAKE_SOURCE_DIR}/oxr_deps/lzo-src/include"
+                )
+                set_target_properties(lzo_static_lib PROPERTIES POSITION_INDEPENDENT_CODE ON)
+                if (NOT TARGET LZO::LZO)
+                    add_library(LZO::LZO ALIAS lzo_static_lib)
+                endif()
+            endif()
+        else()
+            find_package(LZO REQUIRED)
+        endif()
+
         find_package(mimalloc NAMES mimalloc2 mimalloc2.0 mimalloc)
     endif()
 endif()
