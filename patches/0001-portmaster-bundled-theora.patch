diff --git a/cmake/XRay.Compiler.GNULike.cmake b/cmake/XRay.Compiler.GNULike.cmake
--- a/cmake/XRay.Compiler.GNULike.cmake
+++ b/cmake/XRay.Compiler.GNULike.cmake
@@ -169,7 +169,39 @@ if (NOT WIN32)
         find_package(JPEG)
         find_package(Ogg REQUIRED)
         find_package(Vorbis REQUIRED)
-        find_package(Theora REQUIRED)
+
+        # PortMaster / Linux GLES builds reuse the bundled Theora decoder
+        # that is already maintained for Android. This avoids depending on
+        # a distro-specific libtheora package on handheld builders/firmware.
+        if (XRAY_USE_GLES AND NOT TARGET Theora::Theora)
+            set(_theora_src_dir "${CMAKE_SOURCE_DIR}/cmake/android/theora")
+            add_library(xray_theora STATIC
+                "${_theora_src_dir}/apiwrapper.c"
+                "${_theora_src_dir}/bitpack.c"
+                "${_theora_src_dir}/decapiwrapper.c"
+                "${_theora_src_dir}/decinfo.c"
+                "${_theora_src_dir}/decode.c"
+                "${_theora_src_dir}/dequant.c"
+                "${_theora_src_dir}/fragment.c"
+                "${_theora_src_dir}/huffdec.c"
+                "${_theora_src_dir}/idct.c"
+                "${_theora_src_dir}/info.c"
+                "${_theora_src_dir}/internal.c"
+                "${_theora_src_dir}/quant.c"
+                "${_theora_src_dir}/state.c"
+            )
+            set_target_properties(xray_theora PROPERTIES POSITION_INDEPENDENT_CODE ON)
+            target_include_directories(xray_theora
+                PUBLIC "${CMAKE_SOURCE_DIR}/sdk/include"
+                PRIVATE "${_theora_src_dir}"
+            )
+            target_link_libraries(xray_theora PUBLIC Ogg::Ogg)
+            add_library(Theora::Theora ALIAS xray_theora)
+            add_library(Theora::TheoraDec ALIAS xray_theora)
+        else()
+            find_package(Theora REQUIRED)
+        endif()
+
         find_package(LZO REQUIRED)
         find_package(mimalloc NAMES mimalloc2 mimalloc2.0 mimalloc)
     endif()
